{
  "name": "lavadero-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "db:migrate:production": "node dist/database/migrate.js",
    "db:seed:production": "node dist/database/seed.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit:source",
    "test:database": "tsx --test tests/database.integration.ts",
    "docs:schemas": "tsx scripts/exportSchemas.ts",
    "test:acceptance": "tsx --test --test-concurrency=1 tests/security.integration.ts tests/booking.integration.ts tests/team-agenda.integration.ts tests/management.integration.ts tests/oauth.integration.ts tests/oauth-link.integration.ts tests/operations.integration.ts tests/vehicle-later.integration.ts tests/agenda.integration.ts tests/cancellation.integration.ts tests/admin-panel.integration.ts tests/client-employee.integration.ts tests/recovery.integration.ts",
    "audit:source": "tsx scripts/auditSource.ts",
    "docs:source": "node scripts/document-source.mjs",
    "db:retire-legacy-views": "tsx database/retireLegacyViews.ts",
    "db:retire-legacy-views:production": "node dist/database/retireLegacyViews.js",
    "test:cancellations": "tsx --test tests/cancellation.integration.ts",
    "test:admin": "tsx --test tests/admin-panel.integration.ts",
    "test:client-employee": "tsx --test tests/client-employee.integration.ts",
    "test:recovery": "tsx --test tests/recovery.integration.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "jose": "^6.2.14",
    "luxon": "^3.7.2",
    "mysql2": "^3.15.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.13.0",
    "jiti": "^2.6.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
