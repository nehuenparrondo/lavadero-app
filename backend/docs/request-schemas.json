  "appointmentQuerySchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "page": {
        "default": 1,
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "limit": {
        "default": 50,
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "search": {
        "default": "",
        "type": "string",
        "maxLength": 100
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "in_progress",
          "awaiting_review",
          "completed",
          "cancelled"
        ]
      },
      "clientId": {
        "type": "string",
        "pattern": "^[1-9]\\d{0,18}$"
      },
      "employeeId": {
        "type": "string",
        "pattern": "^[1-9]\\d{0,18}$"
      },
      "plate": {
        "type": "string",
        "pattern": "^[a-z0-9 -]{1,24}$"
      },
      "history": {
        "type": "string",
        "enum": ["true", "false"]
      },
      "queue": {
        "type": "string",
        "enum": ["requested"]
      },
      "scope": {
        "type": "string",
        "enum": ["today", "all"]
      },
      "home": {
        "type": "string",
        "enum": ["true"]
      }
    }
  },
  "appointmentSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "vehicleId": {
        "type": "string",
        "pattern": "^[1-9]\\d{0,18}$"
      },
      "vehicleTypeId": {
        "type": "string",
        "pattern": "^[1-9]\\d{0,18}$"
      },
      "serviceIds": {
        "minItems": 1,
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[1-9]\\d{0,18}$"
        }
      },
      "startsAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      },
      "clientId": {
        "type": "string",
        "pattern": "^[1-9]\\d{0,18}$"
      }
    },
    "required": ["serviceIds", "startsAt"],
    "additionalProperties": false
  },
