  "loginSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
      },
      "password": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": ["email", "password"],
    "additionalProperties": false
  },
  "refreshSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
