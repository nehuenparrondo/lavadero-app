  "item": [
    {
      "name": "Crear cuenta Cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "description": "Roles: public. El body no admite rol ni permisos.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"password\": \"Ejemplo-seguro-2026!\",\n  \"firstName\": \"Ana\",\n  \"lastName\": \"Pérez\",\n  \"phone\": \"1100000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) { const s=pm.response.json().data; pm.collectionVariables.set(\"accessToken\",s.accessToken); pm.collectionVariables.set(\"refreshToken\",s.refreshToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "description": "Roles: public. Email y contraseña; límite de intentos por origen.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"password\": \"Ejemplo-seguro-2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) { const s=pm.response.json().data; pm.collectionVariables.set(\"accessToken\",s.accessToken); pm.collectionVariables.set(\"refreshToken\",s.refreshToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Renovar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/refresh",
        "description": "Roles: public. Requiere refresh válido. Rotación/revocación de familia, incluso access tokens ya emitidos.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) { const s=pm.response.json().data; pm.collectionVariables.set(\"accessToken\",s.accessToken); pm.collectionVariables.set(\"refreshToken\",s.refreshToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Cerrar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "description": "Roles: public. Requiere refresh válido. Rotación/revocación de familia, incluso access tokens ya emitidos.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Proveedores sociales habilitados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/providers",
        "description": "Roles: public. No revela IDs privados ni client secrets."
      }
    },
    {
      "name": "Iniciar OAuth con PKCE",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/oauth/{{provider}}/authorize?response_type=code&redirect_uri=lavadero://oauth&state=estado-aleatorio-de-al-menos-16-caracteres&code_challenge=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&code_challenge_method=S256",
        "description": "Roles: public. AuthSession genera state y PKCE S256. redirect_uri debe estar en la allowlist del servidor."
      }
    },
    {
      "name": "Recibir retorno OAuth",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/oauth/{{provider}}/callback?state=estado-del-proveedor&code=codigo-del-proveedor",
        "description": "Roles: public. Solo proveedor→backend. Consume state de un uso; email debe estar verificado. Devuelve deep link con código efímero, nunca JWT."
      }
    },
    {
      "name": "Canjear código móvil por sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/oauth/exchange",
        "description": "Roles: public. PKCE y código de un uso. Vence en 60 segundos; si el correo ya tiene contraseña, OAUTH_LINK_REQUIRED (409) solicita reenviar el mismo code/codeVerifier con password. Ese grant dura 5 minutos y admite hasta cinco intentos. Tras confirmar se vincula el mismo usuario y se emite su sesión.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"codeVerifier\": \"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
