# development | test | production. Render configura production.
NODE_ENV=development
# Puerto interno; Render inyecta PORT automáticamente.
PORT=3000
# MariaDB usa el protocolo mysql://. Codificar contraseña con URL encoding.
# Desarrollo y producción deben usar bases y usuarios separados.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/nehuenlavadero_dev
# Conexión cifrada y certificado verificado, también en alwaysdata.
DATABASE_TLS=true
# Opcional. CA privada en base64 para instalaciones anteriores en Aiven.
# Vacío usa las autoridades públicas del sistema; nunca desactiva la verificación.
DATABASE_CA_BASE64=
# Pool pequeño para el alojamiento gratuito.
DATABASE_POOL_SIZE=3
# Activar solo durante una copia final de datos. Bloquea API, conserva /ready.
MAINTENANCE_MODE=false
# Orígenes web HTTPS separados por coma. Vacío permite solo clientes sin Origin (app nativa).
CORS_ORIGINS=
# Administrador inicial: el seed exige ambos; nunca hay contraseña predeterminada.
SEED_ADMIN_EMAIL=
# 12-72 bytes UTF-8; bcrypt descarta lo que supera los 72 bytes.
SEED_ADMIN_PASSWORD=
# Moneda confirmada por el usuario. Importes almacenados en centavos.
BUSINESS_CURRENCY=ARS
# Zona IANA confirmada: Argentina (Buenos Aires).
BUSINESS_TIME_ZONE=America/Argentina/Buenos_Aires
# Horas locales del negocio, confirmadas por el usuario.
BUSINESS_OPEN_TIME=09:30
BUSINESS_CLOSE_TIME=16:30
# ISO: lunes=1, domingo=7. Lunes a sábado, confirmado.
BUSINESS_OPEN_DAYS=1,2,3,4,5,6
# Vehículos simultáneos: uno, confirmado.
BUSINESS_CAPACITY=1
# Ventana mínima para cancelar, en minutos (regla configurable).
BUSINESS_CANCELLATION_MINUTES=120

# Clave aleatoria privada de al menos 32 caracteres para JWT. Generar por entorno; nunca copiar a Expo.
JWT_ACCESS_SECRET=
# Identificadores de emisor y audiencia exigidos al verificar JWT.
JWT_ISSUER=lavadero-api
JWT_AUDIENCE=lavadero-app
# Origen HTTPS de esta API para callbacks OAuth, sin barra final.
PUBLIC_API_URL=https://lavadero-api-48m4.onrender.com
# Lista exacta de callbacks móviles/web autorizados, separados por coma.
OAUTH_REDIRECT_URIS=lavadero://oauth
# Google: cliente Web con callback /api/v1/auth/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord y GitHub fueron retirados: no habilitar nuevos accesos.
# Mailtrap Sandbox: credenciales privadas solo del backend; no envía a casillas reales.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
PASSWORD_RESET_URL=https://lavadero-app-2558.onrender.com/reset-password
